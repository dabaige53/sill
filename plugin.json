{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "quiet-glass",
  "version": "0.5.0",
  "description": "连接 Sill 云端账号，在 Codex 侧边栏查看和管理卡片。",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Sill · 窗台",
        "shortDescription": "Sill 云端卡片与侧边栏",
        "category": "Productivity",
        "websiteURL": "https://sill-web-preview.scs1213-temp-email.workers.dev/",
        "capabilities": [
          "Read",
          "Write",
          "Interactive"
        ],
        "defaultPrompt": [
          "打开 Sill 云端窗台",
          "查看并整理我的 Sill 云端卡片",
          "将结果保存到 Sill 云端并确认保存成功"
        ]
      }
    }
  }
}
