{
  "openapi": "3.1.0",
  "info": {
    "title": "Sill Card",
    "version": "4.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "summary": {
            "description": "Card face summary: one or two plain-text sentences for the feed card and search results. Not shown in the detail; put all detail text in body.",
            "type": "string",
            "maxLength": 10000
          },
          "authors": {
            "description": "Original content authors, not sources or the agent writing this card.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": {}
            }
          },
          "publisher": {
            "description": "Original publisher, separate from authors and acquisition sources.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          },
          "publishedAt": {
            "description": "Original publication date or offset datetime. Preserve date-only precision.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "modifiedAt": {
            "description": "Original content modification date, not the Sill updated_at timestamp.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "savedAt": {
            "description": "Save date in the external source, not Sill created_at or personal addedAt.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "bodyCoverage": {
            "description": "Coverage of the saved body. Never estimate the entire article from an excerpt or summary.",
            "type": "string",
            "enum": [
              "full",
              "excerpt",
              "summary",
              "none"
            ]
          },
          "readingEstimate": {
            "description": "Estimated reading duration in seconds, not actual reading time. provided requires a known external estimate; calculated requires method and saved bodyCoverage. full calculations require bodyCoverage=full. Recompute or set null when body changes; null explicitly clears the estimate.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31536000
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "provided",
                      "calculated"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "full",
                      "available"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "seconds",
                  "origin",
                  "scope"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sentAt": {
            "description": "Mail only: actual send datetime with timezone; date-only values are invalid.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "recipients": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "project": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          },
          "timeZone": {
            "description": "Event only: IANA timezone identifier such as Asia/Shanghai; numeric offsets are not timezone identifiers.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "chapterCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "takenAt": {
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "caption": {
            "type": "string",
            "maxLength": 2000
          },
          "coverageStart": {
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "coverageEnd": {
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "form": {
            "type": "string",
            "enum": [
              "standard",
              "image",
              "quote",
              "compact",
              "data"
            ]
          },
          "image": {
            "type": "string",
            "enum": [
              "architecture",
              "coast",
              "mountain",
              "botanical"
            ]
          },
          "tags": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "body": {
            "description": "Detail text as one Markdown (CommonMark) string: headings, lists, quotes, emphasis, links and code. Raw HTML is shown as text, images are not loaded, and links must use http, https or mailto.",
            "type": "string",
            "maxLength": 500000
          },
          "url": {
            "type": "string",
            "pattern": "^https?:\\/\\/"
          },
          "sources": {
            "maxItems": 11,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": {}
            }
          },
          "why": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "basis": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": {}
          },
          "sender": {
            "type": "string",
            "maxLength": 300
          },
          "location": {
            "type": "string",
            "maxLength": 300
          },
          "meeting": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/"
              },
              "code": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": {}
          },
          "media": {
            "type": "string",
            "enum": [
              "video",
              "podcast"
            ]
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "files": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "mimeType": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9!#$&^_.+-]+\\/[A-Za-z0-9!#$&^_.+-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modifiedAt": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 40,
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": {}
            }
          },
          "photos": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "architecture",
                "coast",
                "mountain",
                "botanical"
              ]
            }
          },
          "attachment": {
            "type": "string",
            "maxLength": 300
          },
          "tasks": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "done": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": {}
            }
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "due": {
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "people": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "related": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            }
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "id",
          "type",
          "title"
        ],
        "additionalProperties": {},
        "title": "Card",
        "x-contract-version": "4.0.0",
        "x-status": "implemented"
      }
    }
  }
}
