{
  "openapi": "3.1.0",
  "info": {
    "title": "Sill Card",
    "version": "5.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "audioUrl": {
            "description": "Podcast audio URL, read only during playback. Not an acquisition or sync source.",
            "type": "string",
            "pattern": "^https?:[/][/].+$"
          },
          "chapters": {
            "description": "Media only: {start,title} chapters, with start in seconds, strictly increasing and within known duration. Never invent timestamps.",
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "start",
                "title"
              ],
              "additionalProperties": false
            }
          },
          "transcript": {
            "description": "Media only: actual timestamped transcript {start,text}; start in seconds, strictly increasing and within known duration. Ordinary notes belong in body.",
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "required": [
                "start",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "pullRequest": {
            "description": "Required for type=pr only: repository (owner/repo), positive number, state and observedAt (offset ISO datetime). Optional branches, reviewers, checks and statistics reflect observed evidence. Only completed checks may have conclusion. Omit unknown counts, retain known zeros. Never presented as live GitHub state.",
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "state": {
                "type": "string",
                "enum": [
                  "draft",
                  "open",
                  "merged",
                  "closed"
                ]
              },
              "observedAt": {
                "type": "string",
                "pattern": "(?:^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$)|(?:^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$)"
              },
              "headBranch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "baseBranch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "reviewers": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "login": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?:[/][/].+$"
                    },
                    "decision": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "approved",
                        "changesRequested",
                        "commented",
                        "dismissed"
                      ]
                    }
                  },
                  "required": [
                    "login",
                    "decision"
                  ],
                  "additionalProperties": false
                }
              },
              "checks": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "inProgress",
                        "completed"
                      ]
                    },
                    "conclusion": {
                      "type": "string",
                      "enum": [
                        "success",
                        "failure",
                        "neutral",
                        "cancelled",
                        "skipped",
                        "timedOut",
                        "actionRequired",
                        "stale"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?:[/][/].+$"
                    }
                  },
                  "required": [
                    "name",
                    "status"
                  ],
                  "additionalProperties": false
                }
              },
              "additions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deletions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "changedFiles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reviewRequested": {
                "type": "boolean"
              }
            },
            "required": [
              "repository",
              "number",
              "state",
              "observedAt"
            ],
            "additionalProperties": false
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "description": "Card ID. Generated by single-card create; caller supplies a new ID for batch card.upsert."
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Card kind. New cards use the supported cardTypes; media distinguishes video and podcast."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Specific plain-text title, aiming for 10–24 Chinese characters. Use the same title on the face and detail. Keep process notes, image counts and reading time out of the title; retain the source title in body only when different and useful."
          },
          "summary": {
            "description": "One or two plain-text sentences, aiming for 50–60 characters. The face shows at most 120 characters; the detail shows the full summary before body. For photos, use a factual image description. Do not duplicate the summary in body.",
            "type": "string",
            "maxLength": 10000
          },
          "authors": {
            "description": "Original authors, publisher or mail sender, not sources or the writing agent. The first author is shown as the mail sender. Applies to article, note, mail, media, digest, suggestion and file.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:[/][/].+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "publishedAt": {
            "description": "Original publication, send or capture date, or offset datetime. Preserve date-only precision.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "project": {
            "description": "Task or reminder only: existing project name and optional HTTP(S) link.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "pattern": "^https?:[/][/].+$"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "form": {
            "description": "Note only: quote shows the title as a quotation. Omit for the default layout.",
            "type": "string",
            "enum": [
              "quote"
            ]
          },
          "images": {
            "description": "Built-in illustrative asset IDs or HTTPS image URLs, not uploads. The first image is the cover; photo cards show all. Required for video and photo cards; never substitute for a real user photo.",
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^(?:(?:architecture|coast|mountain|botanical)$|https:\\/\\/[^\\s/@?#]+(?:[/?#][^\\s]*)?$)"
            }
          },
          "tags": {
            "description": "Content tags. Editing tags edits the card.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "body": {
            "description": "Detail text as one Markdown (CommonMark) string: headings, lists, quotes, emphasis, links and code. Use actual newline characters; serialize JSON once. Do not send an array, a JSON document string, or an enclosing Markdown fence. Raw HTML is shown as text, images are not loaded, and links must use http, https or mailto. Reading time is calculated from it.",
            "type": "string",
            "maxLength": 500000
          },
          "url": {
            "description": "Original HTTP(S) source link; video uses its platform page URL. Not an upload or fetch instruction.",
            "type": "string",
            "pattern": "^https?:[/][/].+$"
          },
          "sources": {
            "description": "Acquisition sources as {name,kind}; not authors. Records provenance without connecting to the source.",
            "maxItems": 11,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "location": {
            "description": "Known event or photo location; omit if unavailable.",
            "type": "string",
            "maxLength": 300
          },
          "meeting": {
            "description": "Existing meeting reference {name,url,code?}, not a request to create a meeting. Never store credentials in the URL or code.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "pattern": "^https?:[/][/].+$"
              },
              "code": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          },
          "media": {
            "description": "Media subtype, independent of type=media and file MIME type.",
            "type": "string",
            "enum": [
              "video",
              "podcast"
            ]
          },
          "duration": {
            "description": "Known media duration in integer seconds. Unknown is omitted, not zero.",
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "files": {
            "description": "Files or mail attachments: name, optional MIME type, integer sizeBytes, original modifiedAt and HTTP(S) url. No binary/base64 upload. File cards require a nonempty list.",
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "mimeType": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9!#$&^_.+-]+\\/[A-Za-z0-9!#$&^_.+-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modifiedAt": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 40,
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:[/][/].+$"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "tasks": {
            "description": "Task card actionable subtasks as {id,text}; new or changed lists contain 1–6 items with unique stable IDs. Split larger work into multiple cards by topic. Stored legacy lists retain up to 100 items until explicitly reorganized. Completion is personal state taskDone.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "start": {
            "description": "Event start as Unix milliseconds, greater than zero; pair with end.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "end": {
            "description": "Event end as Unix milliseconds, strictly later than start.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "due": {
            "description": "Known task/reminder due time as Unix milliseconds; recording it does not schedule an external notification.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "time": {
            "description": "Card timeline time in Unix milliseconds; separate from publishedAt.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "people": {
            "description": "Event only: known attendees; do not invent participants.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "related": {
            "description": "Real Sill card IDs read under the current permissions; not titles or URLs.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            }
          },
          "priority": {
            "description": "Priority from 0 to 10, only when requested or supported by source facts.",
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "id",
          "type",
          "title"
        ],
        "additionalProperties": false,
        "title": "Card",
        "x-contract-version": "5.0.0",
        "x-status": "implemented"
      }
    }
  }
}
