{
  "openapi": "3.1.0",
  "info": {
    "title": "Sill Card",
    "version": "4.2.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "audioUrl": {
            "description": "Podcast audio URL, read only during playback. Not an acquisition or sync source.",
            "type": "string",
            "pattern": "^https?:\\/\\/"
          },
          "chapters": {
            "description": "Media only: {start,title} chapters, with start in seconds, strictly increasing and within known duration. Count must not exceed chapterCount. Never invent timestamps.",
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "start",
                "title"
              ],
              "additionalProperties": {}
            }
          },
          "transcript": {
            "description": "Media only: actual timestamped transcript {start,text}; start in seconds, strictly increasing and within known duration. Ordinary notes belong in body.",
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "required": [
                "start",
                "text"
              ],
              "additionalProperties": {}
            }
          },
          "attachments": {
            "description": "Mail only: actual attachments {name,url?,mimeType?,sizeBytes?}; no binary or base64. An explicit [] clears the list and overrides the legacy attachment label.",
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                },
                "mimeType": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9!#$&^_.+-]+\\/[A-Za-z0-9!#$&^_.+-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": {}
            }
          },
          "pullRequest": {
            "description": "Required for type=pr only: repository (owner/repo), positive number, state and observedAt (offset ISO datetime). Optional branches, author, reviewers, checks, statistics and files reflect observed evidence. Only completed checks may have conclusion; listed files cannot exceed known changedFiles. Omit unknown counts, retain known zeros. Never presented as live GitHub state.",
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "state": {
                "type": "string",
                "enum": [
                  "draft",
                  "open",
                  "merged",
                  "closed"
                ]
              },
              "observedAt": {
                "type": "string",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
              },
              "headBranch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "baseBranch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "author": {
                "type": "object",
                "properties": {
                  "login": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?:\\/\\/"
                  }
                },
                "required": [
                  "login"
                ],
                "additionalProperties": {}
              },
              "reviewers": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "login": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?:\\/\\/"
                    },
                    "decision": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "approved",
                        "changesRequested",
                        "commented",
                        "dismissed"
                      ]
                    }
                  },
                  "required": [
                    "login",
                    "decision"
                  ],
                  "additionalProperties": {}
                }
              },
              "checks": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "inProgress",
                        "completed"
                      ]
                    },
                    "conclusion": {
                      "type": "string",
                      "enum": [
                        "success",
                        "failure",
                        "neutral",
                        "cancelled",
                        "skipped",
                        "timedOut",
                        "actionRequired",
                        "stale"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?:\\/\\/"
                    }
                  },
                  "required": [
                    "name",
                    "status"
                  ],
                  "additionalProperties": {}
                }
              },
              "additions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deletions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "changedFiles": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "comments": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reviewRequested": {
                "type": "boolean"
              },
              "files": {
                "maxItems": 3000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "additions": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "deletions": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "repository",
              "number",
              "state",
              "observedAt"
            ],
            "additionalProperties": {}
          },
          "id": {
            "description": "Card ID. Generated by single-card create; caller supplies a new ID for batch card.upsert.",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "type": {
            "description": "Card kind. New cards use the supported cardTypes; media distinguishes video and podcast.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "description": "Specific plain-text title; do not place the full body here.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "summary": {
            "description": "Card face summary: one or two plain-text sentences for the feed card and search results. Not shown in the detail; put all detail text in body.",
            "type": "string",
            "maxLength": 10000
          },
          "authors": {
            "description": "Original content authors, not sources or the writing agent. Applies to article, note, mail, media, digest, suggestion and file.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": {}
            }
          },
          "publisher": {
            "description": "Article, note, mail, media, digest, suggestion or file only: original publisher, separate from authors and sources.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          },
          "publishedAt": {
            "description": "Original publication date or offset datetime. Preserve date-only precision.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "modifiedAt": {
            "description": "Original content modification date, not the Sill updated_at timestamp.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "savedAt": {
            "description": "Save date in the external source, not Sill created_at or personal addedAt.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "bodyCoverage": {
            "description": "Article, note, mail, digest, suggestion or file only: saved body coverage. full=complete, excerpt=partial, summary=summary only, none=no body. Never label an excerpt as full.",
            "type": "string",
            "enum": [
              "full",
              "excerpt",
              "summary",
              "none"
            ]
          },
          "readingEstimate": {
            "description": "Article, note, mail, digest, suggestion or file only: estimated reading seconds, not actual reading time. provided requires a known external estimate; calculated requires method and saved bodyCoverage. full calculations require bodyCoverage=full. Recompute or set null when body changes; null explicitly clears the estimate.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31536000
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "provided",
                      "calculated"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "full",
                      "available"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "seconds",
                  "origin",
                  "scope"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "section": {
            "description": "Article section name, separate from tags.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sentAt": {
            "description": "Mail only: actual send datetime with timezone; date-only values are invalid.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "recipients": {
            "description": "Mail only: actual recipient names or addresses. Do not assume the current user is a recipient.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "project": {
            "description": "Task or reminder only: existing project name and optional HTTP(S) link.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          },
          "timeZone": {
            "description": "Event only: IANA timezone identifier such as Asia/Shanghai; numeric offsets are not timezone identifiers.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "chapterCount": {
            "description": "Media only: known total chapter count, at least chapters.length; omit when unknown.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "takenAt": {
            "description": "Photo only: actual capture date or offset datetime; retain date-only precision.",
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
          },
          "caption": {
            "description": "Photo only: factual image description, not a personal note.",
            "type": "string",
            "maxLength": 2000
          },
          "coverageStart": {
            "description": "Digest only: coverage start in Unix milliseconds; supply with coverageEnd.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "coverageEnd": {
            "description": "Digest only: coverage end in Unix milliseconds, strictly after coverageStart.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "form": {
            "description": "Optional existing template hint, not HTML/CSS or a content type. Omit for the default layout.",
            "type": "string",
            "enum": [
              "standard",
              "image",
              "quote",
              "compact",
              "data"
            ]
          },
          "image": {
            "description": "Built-in illustrative asset ID only, not an image URL or upload. Required for video; never substitute for a real user photo.",
            "type": "string",
            "maxLength": 8192,
            "pattern": "^(?:(?:architecture|coast|mountain|botanical)$|https:\\/\\/[^\\s/@?#]+(?:[/?#][^\\s]*)?$)"
          },
          "tags": {
            "description": "Content tags. Personal edited tags use state.tags plus state.tagsEdited.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "body": {
            "description": "Detail text as one Markdown (CommonMark) string: headings, lists, quotes, emphasis, links and code. Use actual newline characters; serialize JSON once. Do not send an array, a JSON document string, or an enclosing Markdown fence. Raw HTML is shown as text, images are not loaded, and links must use http, https or mailto.",
            "type": "string",
            "maxLength": 500000
          },
          "url": {
            "description": "Original HTTP(S) source link; video uses its platform page URL. Not an upload or fetch instruction.",
            "type": "string",
            "pattern": "^https?:\\/\\/"
          },
          "sources": {
            "description": "Acquisition sources as {name,kind}; not authors, publisher or sender. Records provenance without connecting to the source.",
            "maxItems": 11,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": {}
            }
          },
          "why": {
            "description": "Suggestion rationale: reason plus optional factual basis. Keep recommendation distinct from evidence and do not execute it automatically.",
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "basis": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": {}
          },
          "sender": {
            "description": "Actual mail sender; never infer from acquisition source.",
            "type": "string",
            "maxLength": 300
          },
          "location": {
            "description": "Known event location; omit if unavailable.",
            "type": "string",
            "maxLength": 300
          },
          "meeting": {
            "description": "Existing meeting reference {name,url,code?}, not a request to create a meeting. Never store credentials in the URL or code.",
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/"
              },
              "code": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": {}
          },
          "media": {
            "description": "Media subtype, independent of type=media and file MIME type.",
            "type": "string",
            "enum": [
              "video",
              "podcast"
            ]
          },
          "duration": {
            "description": "Known media duration in integer seconds. Unknown is omitted, not zero.",
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "files": {
            "description": "File descriptions: name, optional MIME type, integer sizeBytes, original modifiedAt and HTTP(S) url. No binary/base64 upload; no meta/time. File cards require a nonempty list.",
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "mimeType": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9!#$&^_.+-]+\\/[A-Za-z0-9!#$&^_.+-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modifiedAt": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 40,
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,9})?)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d))?$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?:\\/\\/"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": {}
            }
          },
          "photos": {
            "description": "Photo card built-in illustrative asset IDs only; not real photo uploads or URLs.",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^(?:(?:architecture|coast|mountain|botanical)$|https:\\/\\/[^\\s/@?#]+(?:[/?#][^\\s]*)?$)"
            }
          },
          "attachment": {
            "description": "Legacy single mail attachment label. Prefer structured attachments for new cards; no uploaded file data.",
            "type": "string",
            "maxLength": 300
          },
          "tasks": {
            "description": "Task card actionable subtasks as {id,text,done?}; use nonempty tasks with unique stable IDs. Markdown checkboxes do not create interactive tasks.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "done": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": {}
            }
          },
          "start": {
            "description": "Event start as Unix milliseconds, greater than zero; pair with end.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "end": {
            "description": "Event end as Unix milliseconds, strictly later than start.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "due": {
            "description": "Known task/reminder due time as Unix milliseconds; recording it does not schedule an external notification.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "time": {
            "description": "Card timeline time in Unix milliseconds; separate from original publication, send and save dates.",
            "type": "number",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "people": {
            "description": "Known people involved, such as task participants or event attendees; do not invent assignments.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "related": {
            "description": "Real Sill card IDs read under the current permissions; not titles or URLs.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            }
          },
          "priority": {
            "description": "Priority from 0 to 10, only when requested or supported by source facts.",
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "id",
          "type",
          "title"
        ],
        "additionalProperties": {},
        "title": "Card",
        "x-contract-version": "4.2.0",
        "x-status": "implemented"
      }
    }
  }
}
