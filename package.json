{
  "name": "quiet-glass",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs --http",
    "mcp": "node --env-file-if-exists=.env server/index.mjs --stdio",
    "pretest": "npm run plugin:build",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "plugin:build": "node scripts/build-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
