{
	"name": "sill",
	"version": "1.2.18",
	"private": true,
	"description": "AI-assisted personal card workspace for reading, tasks, and schedules",
	"scripts": {
		"release:prepare": "node scripts/prepare-release.ts",
		"build": "node scripts/build.ts",
		"test": "npm run files:check && npm run build && npm run check && npm run typecheck && npm run test:contracts && npm run test:core && npm run test:server && npm run test:performance-report",
		"contracts:generate": "node design-system/scripts/export-data.ts && node scripts/export-preparation.ts && node scripts/export-contracts.ts && node scripts/export-design.ts",
		"contracts:check": "node design-system/scripts/export-data.ts --check && node scripts/export-preparation.ts --check && node scripts/export-contracts.ts --check && node scripts/export-design.ts --check && node scripts/check-contracts.ts",
		"test:contracts": "npm run contracts:check && node --import tsx --test tests/contracts/*.test.ts",
		"test:browser": "node tests/e2e/browser.ts",
		"start": "node server/local/index.ts",
		"check": "node scripts/check.ts",
		"plugin:build": "npm run build && node scripts/build-plugin.ts",
		"test:core": "node --import tsx --test tests/web/*.test.ts",
		"test:local": "node --import tsx --test tests/server/local.test.ts tests/server/plugin-package.test.ts",
		"test:local-browser": "node tests/e2e/local-browser.ts",
		"boards": "node scripts/serve-boards.ts",
		"design": "sh scripts/design-init.sh",
		"test:navigation-recovery": "node tests/e2e/navigation-recovery-browser.ts",
		"test:supabase": "node --import tsx --test tests/server/supabase-preparation.test.ts tests/server/supabase-rpc.test.ts tests/server/supabase-boundary.test.ts tests/server/supabase-jwt.test.ts tests/server/supabase-http.test.ts tests/server/supabase-http-session.test.ts tests/server/supabase-http-worker.test.ts tests/server/supabase-snapshots.test.ts tests/server/supabase-mcp.test.ts",
		"test:supabase:postgres": "node --import tsx --test tests/server/supabase-postgres.ts",
		"build:cloud": "node scripts/build-cloud.ts && node scripts/build-cloud-worker.ts",
		"test:cloud-browser": "node tests/e2e/cloud-browser.ts",
		"test:cloud-welcome": "node tests/e2e/cloud-welcome-browser.ts",
		"test:oauth": "node --import tsx --test tests/server/consent-policy.test.ts tests/server/oauth-consent.test.ts",
		"test:oauth-browser": "node tests/e2e/oauth-browser.ts",
		"build:release": "node scripts/build-cloud.ts && node scripts/build-cloud-worker.ts --minify",
		"test:cloud-app": "node --import tsx --test tests/server/cloud-app.test.ts",
		"test:cloud-app-browser": "node tests/e2e/cloud-app-browser.ts",
		"build:macos": "node scripts/build-macos.ts",
		"test:macos": "node tests/apple/run.ts && codesign --verify --deep --strict dist/macos/Sill.app",
		"test:workspace-polish": "node tests/e2e/workspace-polish-browser.ts",
		"test:cloud-recovery": "node tests/e2e/cloud-recovery-browser.ts",
		"measure:layout": "node tests/e2e/layout-performance.ts",
		"files:check": "node scripts/check-files.ts",
		"typecheck": "tsc --noEmit",
		"test:server": "node --import tsx --test tests/server/*.test.ts",
		"local:cli": "node scripts/sill.ts",
		"format": "node scripts/format.ts",
		"lint": "node scripts/format.ts --check",
		"lint:web": "node scripts/format.ts --check --web",
		"lint:apple": "node scripts/format.ts --check --apple",
		"test:cloud-operations": "node tests/e2e/cloud-operations-browser.ts",
		"test:selection-browser": "node tests/e2e/selection-browser.ts",
		"test:material-density": "node tests/e2e/material-density-browser.ts",
		"test:motion-material": "node tests/e2e/motion-material-browser.ts",
		"test:pwa-touch": "node tests/e2e/pwa-touch-browser.ts",
		"dev": "node scripts/dev.ts",
		"dev:cloud": "node scripts/dev.ts --cloud",
		"test:performance-report": "node --import tsx --test tests/apple/*.test.ts",
		"perf:macos": "node scripts/performance-macos.ts",
		"package:macos": "node scripts/package-macos.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@electric-sql/pglite": "0.5.9",
		"@modelcontextprotocol/ext-apps": "1.7.5",
		"@tailwindcss/cli": "^4.3.3",
		"@types/markdown-it": "14.1.2",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"esbuild": "0.28.2",
		"jsdom": "26.1.0",
		"playwright": "1.62.1",
		"tailwindcss": "^4.3.3",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vite-plugin-singlefile": "2.3.4",
		"wrangler": "4.151.0"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"@supabase/supabase-js": "2.117.3",
		"aws4fetch": "1.0.20",
		"markdown-it": "14.3.3",
		"motion": "12.23.24",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"vaul": "1.1.2",
		"zod": "4.6.6"
	}
}
