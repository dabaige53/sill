{
  "name": "quiet-glass",
  "version": "0.4.1",
  "private": true,
  "description": "Local card workspace with shared UI and agent operations",
  "scripts": {
    "build": "python3 scripts/build.py",
    "test": "npm run build && npm run check && npm run test:local",
    "test:browser": "node tests/browser.cjs",
    "start": "node server/local.mjs",
    "check": "node scripts/check.mjs",
    "plugin:build": "npm run build && node scripts/build-plugin.mjs",
    "test:core": "python3 tests/verify.py",
    "test:live-browser": "node tests/live-browser.mjs",
    "test:settings-browser": "node tests/settings-browser.mjs",
    "test:content-browser": "node tests/content-browser.mjs",
    "build:host": "node scripts/build-host.mjs",
    "test:host-browser": "npm run build:host && node tests/host-browser.mjs",
    "test:conversations-browser": "node tests/conversations-browser.mjs",
    "test:ai-browser": "node tests/ai-browser.mjs",
    "test:provenance-browser": "npm run build:host && node tests/provenance-browser.mjs",
    "test:preferences-browser": "npm run build:host && node tests/preferences-browser.mjs",
    "test:jobs-browser": "npm run build:host && node tests/jobs-browser.mjs",
    "test:scripts-browser": "npm run build:host && node tests/scripts-browser.mjs",
    "test:backups-browser": "npm run build:host && node tests/backups-browser.mjs",
    "ai": "node scripts/qg.mjs",
    "test:local": "node --test tests/local.test.mjs tests/plugin-package.test.mjs",
    "test:local-browser": "node tests/local-browser.mjs",
    "start:legacy": "node --env-file-if-exists=.env server/index.mjs --http",
    "mcp:legacy": "node --env-file-if-exists=.env server/index.mjs --stdio",
    "test:legacy": "npm run plugin:build && node --test --test-concurrency=1 tests/*.test.mjs",
    "boards": "node -e \"console.log('Sill \u8bbe\u8ba1\u753b\u677f\uff1ahttp://127.0.0.1:4310/')\" && python3 -m http.server 4310 --bind 127.0.0.1 --directory design-system/boards",
    "test:accessibility": "node tests/accessibility-browser.mjs",
    "test:supabase": "node --test tests/supabase-preparation.test.mjs tests/supabase-rpc.test.mjs tests/supabase-boundary.test.mjs tests/supabase-jwt.test.mjs tests/supabase-http.test.mjs tests/supabase-snapshots.test.mjs tests/supabase-mcp.test.mjs",
    "test:supabase:postgres": "node --test tests/supabase-postgres.mjs",
    "build:cloud": "python3 scripts/build-cloud.py && node scripts/build-cloud-worker.mjs",
    "test:cloud-browser": "node tests/cloud-browser.mjs",
    "test:cloud-welcome": "node tests/cloud-welcome-browser.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@openai/mcp-extensions": "0.1.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright": "1.62.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@supabase/supabase-js": "2.117.3",
    "zod": "3.25.76"
  }
}
