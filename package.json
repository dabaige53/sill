{
  "name": "quiet-glass",
  "version": "0.4.0",
  "private": true,
  "description": "Card-first personal information space with local-first MCP integration",
  "scripts": {
    "build": "python3 scripts/build.py",
    "test": "npm run test:core && npm run test:integration",
    "test:browser": "node tests/browser.cjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "preview:storybook": "python3 -m http.server 6006 --bind 127.0.0.1 --directory storybook-static",
    "test:storybook": "node tests/storybook.cjs",
    "start": "node --env-file-if-exists=.env server/index.mjs --http",
    "mcp": "node --env-file-if-exists=.env server/index.mjs --stdio",
    "check": "node scripts/check.mjs",
    "plugin:build": "npm run build:host && node scripts/build-plugin.mjs",
    "test:core": "python3 tests/verify.py",
    "test:integration": "npm run plugin:build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:live-browser": "node tests/live-browser.mjs",
    "test:settings-browser": "node tests/settings-browser.mjs",
    "test:content-browser": "node tests/content-browser.mjs",
    "build:host": "node scripts/build-host.mjs",
    "test:host-browser": "npm run build:host && node tests/host-browser.mjs",
    "test:conversations-browser": "node tests/conversations-browser.mjs",
    "test:ai-browser": "node tests/ai-browser.mjs",
    "test:provenance-browser": "npm run build:host && node tests/provenance-browser.mjs",
    "test:preferences-browser": "npm run build:host && node tests/preferences-browser.mjs",
    "test:jobs-browser": "npm run build:host && node tests/jobs-browser.mjs",
    "test:scripts-browser": "npm run build:host && node tests/scripts-browser.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@openai/mcp-extensions": "0.1.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/html-vite": "10.6.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "storybook": "10.6.1",
    "vite": "7.3.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  }
}
