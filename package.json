{
	"name": "sill",
	"version": "1.2.3",
	"private": true,
	"description": "Local card workspace with shared UI and agent operations",
	"scripts": {
		"build": "node scripts/build.ts",
		"test": "npm run files:check && npm run contracts:check && npm run build && npm run check && npm run typecheck && npm run test:contracts && npm run test:core && npm run test:server",
		"contracts:generate": "node scripts/export-contracts.ts && node scripts/export-design.ts",
		"contracts:check": "node scripts/export-contracts.ts --check && node scripts/export-design.ts --check && node scripts/check-contracts.ts",
		"test:contracts": "npm run contracts:check && node --test tests/contracts/*.test.ts",
		"test:browser": "node tests/e2e/browser.ts",
		"start": "node server/local/index.ts",
		"check": "node scripts/check.ts",
		"plugin:build": "npm run build && node scripts/build-plugin.ts",
		"test:core": "node --test tests/web/*.test.ts",
		"test:local": "node --test tests/server/local.test.ts tests/server/plugin-package.test.ts",
		"test:local-browser": "node tests/e2e/local-browser.ts",
		"boards": "node scripts/serve-boards.ts",
		"test:accessibility": "node tests/e2e/accessibility-browser.ts",
		"test:supabase": "node --test tests/server/supabase-preparation.test.ts tests/server/supabase-rpc.test.ts tests/server/supabase-boundary.test.ts tests/server/supabase-jwt.test.ts tests/server/supabase-http.test.ts tests/server/supabase-http-session.test.ts tests/server/supabase-http-worker.test.ts tests/server/supabase-snapshots.test.ts tests/server/supabase-mcp.test.ts",
		"test:supabase:postgres": "node --test tests/server/supabase-postgres.ts",
		"build:cloud": "node scripts/build-cloud.ts && node scripts/build-cloud-worker.ts",
		"test:cloud-browser": "node tests/e2e/cloud-browser.ts",
		"test:cloud-welcome": "node tests/e2e/cloud-welcome-browser.ts",
		"test:oauth": "node --test tests/server/consent-policy.test.ts tests/server/oauth-consent.test.ts",
		"test:oauth-browser": "node tests/e2e/oauth-browser.ts",
		"build:release": "node scripts/build-cloud.ts && node scripts/build-cloud-worker.ts --minify",
		"test:cloud-app": "node --test tests/server/cloud-app.test.ts",
		"test:cloud-app-browser": "node tests/e2e/cloud-app-browser.ts",
		"build:macos": "node scripts/build-macos.ts",
		"test:macos": "node tests/apple/run.ts && codesign --verify --deep --strict dist/macos/Sill.app",
		"test:workspace-polish": "node tests/e2e/workspace-polish-browser.ts",
		"test:cloud-recovery": "node tests/e2e/cloud-recovery-browser.ts",
		"measure:layout": "node tests/e2e/layout-performance.ts",
		"files:check": "node scripts/check-files.ts",
		"typecheck": "tsc --noEmit",
		"test:server": "node --test tests/server/*.test.ts",
		"local:cli": "node scripts/sill.ts",
		"format": "node scripts/format.ts",
		"lint": "node scripts/format.ts --check",
		"lint:web": "node scripts/format.ts --check --web",
		"lint:apple": "node scripts/format.ts --check --apple",
		"test:cloud-operations": "node tests/e2e/cloud-operations-browser.ts",
		"test:selection-browser": "node tests/e2e/selection-browser.ts",
		"test:material-density": "node tests/e2e/material-density-browser.ts",
		"test:motion-material": "node tests/e2e/motion-material-browser.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@electric-sql/pglite": "0.5.9",
		"@modelcontextprotocol/ext-apps": "1.7.5",
		"@types/node": "26.6.5",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"axe-core": "4.14.0",
		"esbuild": "0.28.2",
		"jsdom": "26.1.0",
		"playwright": "1.62.1",
		"typescript": "7.0.2",
		"wrangler": "4.151.0"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"@supabase/supabase-js": "2.117.3",
		"zod": "3.25.76"
	}
}
