{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sill-codex-sidebar",
  "version": "0.1.0",
  "description": "Codex 专用的 Sill 云端侧边栏入口，与原有产品插件并存。",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Sill · Codex 侧边栏",
        "shortDescription": "在 Codex 侧边栏打开 Sill 云端卡片",
        "category": "Productivity",
        "websiteURL": "https://sill-web-preview.scs1213-temp-email.workers.dev/",
        "capabilities": [
          "Read",
          "Write",
          "Interactive"
        ],
        "defaultPrompt": [
          "在 Codex 侧边栏打开 Sill",
          "查看我的 Sill 云端卡片"
        ],
        "logo": "./assets/sill-icon.png",
        "composerIcon": "./assets/sidebar.svg",
        "composerIconDark": "./assets/sidebar.svg"
      },
      "apps": "./.app.json"
    }
  }
}
