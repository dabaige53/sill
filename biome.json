{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"apps/web/**/*.ts",
			"apps/web/**/*.tsx",
			"apps/web/**/*.css",
			"apps/web/styles/styles.json",
			"server/**/*.ts",
			"contracts/**/*.ts",
			"contracts/fixtures.json",
			"contracts/migration-fixtures.json",
			"scripts/**/*.ts",
			"tests/**/*.ts",
			"design-system/scripts/**/*.ts",
			"design-system/copy.ts",
			"design-system/copy/zh-Hans/*.json",
			"design-system/tokens/*.json",
			"contracts/design/openapi-source.json",
			"package.json",
			"tsconfig.json",
			"biome.json",
			"plugin.json",
			".app.json",
			"!!**/node_modules",
			"!!**/.build",
			"!!**/.claude",
			"!!tests/artifacts"
		]
	},
	"formatter": {
		"lineWidth": 100
	}
}
