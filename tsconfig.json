{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false,
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"node"
		],
		"jsx": "react-jsx"
	},
	"include": [
		"apps/web/**/*.ts",
		"apps/web/**/*.tsx",
		"server/**/*.ts",
		"contracts/**/*.ts",
		"scripts/**/*.ts",
		"tests/**/*.ts",
		"design-system/scripts/**/*.ts",
		"design-system/copy.ts"
	]
}
