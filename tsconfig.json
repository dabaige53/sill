{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["apps/web/**/*.ts", "server/**/*.ts", "contracts/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "design-system/scripts/**/*.ts"]
}
