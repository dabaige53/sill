{
  "dataDir": ".quiet-glass",
  "connectors": [
    {
      "id": "calendar",
      "label": "\u6211\u7684\u65e5\u5386",
      "type": "google-calendar",
      "calendarId": "primary",
      "tokenEnv": "GOOGLE_ACCESS_TOKEN",
      "enabled": true,
      "allowWrites": false
    },
    {
      "id": "notion",
      "label": "\u6211\u7684 Notion",
      "type": "notion",
      "tokenEnv": "NOTION_TOKEN",
      "version": "2025-09-03",
      "enabled": true,
      "allowWrites": false
    },
    {
      "id": "reading-mcp",
      "label": "\u9605\u8bfb\u5185\u5bb9\u6e90",
      "type": "mcp",
      "url": "https://your-mcp-server.example/mcp",
      "tokenEnv": "READING_MCP_TOKEN",
      "enabled": false,
      "allowWrites": false,
      "readTools": [
        "list_articles"
      ],
      "writeTools": [],
      "collect": {
        "tool": "list_articles",
        "arguments": {
          "limit": 20
        },
        "itemsPath": "items",
        "fields": {
          "id": "id",
          "title": "title",
          "content": "content",
          "url": "url",
          "publishedAt": "publishedAt"
        },
        "cursorArgument": "cursor",
        "cursorPath": "nextCursor"
      }
    }
  ],
  "ai": {
    "enabled": false,
    "model": "",
    "apiKeyEnv": "OPENAI_API_KEY",
    "maxOutputTokens": 1024,
    "timeoutMs": 60000,
    "maxConcurrency": 1,
    "maxContextChars": 16000,
    "maxRequestsPerDay": 20
  },
  "access": {
    "principals": [
      {
        "id": "example-reader",
        "enabled": false,
        "tokenEnv": "QG_EXAMPLE_READER_TOKEN",
        "tools": [
          "qg_search",
          "qg_get_card"
        ],
        "resources": {
          "sourceIds": [
            "local-notes"
          ],
          "ingestSourceIds": []
        },
        "limits": {
          "requestsPerMinute": 60,
          "maxRequestBytes": 65536,
          "maxConcurrent": 2
        }
      }
    ]
  },
  "jobs": {
    "enabled": false
  },
  "scripts": {
    "enabled": false
  }
}
