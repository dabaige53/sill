# Load these into the server process; never paste credentials into Codex chat.
# Node >=24: node --env-file=.env server/index.mjs --http
QG_AUTH_TOKEN=
GOOGLE_ACCESS_TOKEN=
NOTION_TOKEN=
READING_MCP_TOKEN=
# Optional Google refresh credentials; configure the corresponding *Env keys.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# QG_CONFIG=/absolute/path/quiet-glass.config.json
# QG_DATA_DIR=/absolute/path/private-data
# QG_HOST=127.0.0.1
# QG_PORT=4317
# QG_PUBLIC_ORIGIN=https://your-private-host.example

# Optional standalone AI; disabled by default. Only the operator sets this.
# Choose a model and opt in through config before an explicit per-question start.
OPENAI_API_KEY=
